<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:overScrollMode="never"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:paddingBottom="88dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingBottom="6dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="大学课表"
                android:textColor="@color/text_main"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_app_version"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="v1.3"
                android:textColor="@color/text_light"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- 学期设置 -->
        <TextView style="@style/SectionTitle" android:text="学期设置" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:paddingStart="4dp"
            android:paddingEnd="4dp">

            <LinearLayout style="@style/SettingRow" android:id="@+id/row_semester_name">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="学期名称"
                    android:textColor="@color/text_main"
                    android:textSize="14sp" />
                <TextView
                    android:id="@+id/tv_semester_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_sub"
                    android:textSize="13sp" />
            </LinearLayout>

            <View style="@style/RowDivider" />

            <LinearLayout style="@style/SettingRow" android:id="@+id/row_start_date">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="开学日期（第 1 周周日）"
                    android:textColor="@color/text_main"
                    android:textSize="14sp" />
                <TextView
                    android:id="@+id/tv_start_date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_sub"
                    android:textSize="13sp" />
            </LinearLayout>

            <View style="@style/RowDivider" />

            <LinearLayout style="@style/SettingRow" android:id="@+id/row_total_weeks">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="学期总周数"
                    android:textColor="@color/text_main"
                    android:textSize="14sp" />
                <TextView
                    android:id="@+id/tv_total_weeks"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_sub"
                    android:textSize="13sp" />
            </LinearLayout>

            <View style="@style/RowDivider" />

            <LinearLayout style="@style/SettingRow">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="学期结束日期"
                    android:textColor="@color/text_main"
                    android:textSize="14sp" />
                <TextView
                    android:id="@+id/tv_semester_end"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_sub"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- 节假日与调休 -->
        <TextView style="@style/SectionTitle" android:layout_marginTop="20dp" android:text="节假日与调休" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:paddingStart="4dp"
            android:paddingEnd="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="12dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="法定节假日自动停课"
                    android:textColor="@color/text_main"
                    android:textSize="14sp" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/sw_holiday_skip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textOff=""
                    android:textOn="" />
            </LinearLayout>

            <View style="@style/RowDivider" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="12dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="调休上班日按课表上课"
                    android:textColor="@color/text_main"
                    android:textSize="14sp" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/sw_makeup"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textOff=""
                    android:textOn="" />
            </LinearLayout>

            <View style="@style/RowDivider" />

            <LinearLayout style="@style/SettingRow" android:id="@+id/row_holiday_list">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="本学期节假日与调休"
                    android:textColor="@color/text_main"
                    android:textSize="14sp" />
                <TextView
                    android:id="@+id/tv_holiday_summary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/primary"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- 上课提醒 -->
        <TextView style="@style/SectionTitle" android:layout_marginTop="20dp" android:text="上课提醒" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:paddingStart="4dp"
            android:paddingEnd="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="12dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="启用上课提醒"
                    android:textColor="@color/text_main"
                    android:textSize="14sp" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/sw_reminder"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textOff=""
                    android:textOn="" />
            </LinearLayout>

            <View style="@style/RowDivider" />

            <LinearLayout style="@style/SettingRow" android:id="@+id/row_lead">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="提前提醒时间"
                    android:textColor="@color/text_main"
                    android:textSize="14sp" />
                <TextView
                    android:id="@+id/tv_lead"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_sub"
                    android:textSize="13sp" />
            </LinearLayout>

            <View style="@style/RowDivider" />

            <LinearLayout style="@style/SettingRow" android:id="@+id/row_permission">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="通知权限"
                    android:textColor="@color/text_main"
                    android:textSize="14sp" />
                <TextView
                    android:id="@+id/tv_permission"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_sub"
                    android:textSize="13sp" />
            </LinearLayout>

            <View style="@style/RowDivider" />

            <LinearLayout style="@style/SettingRow" android:id="@+id/row_test">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="发送一条测试通知"
                    android:textColor="@color/primary"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- 数据管理 -->
        <TextView style="@style/SectionTitle" android:layout_marginTop="20dp" android:text="数据管理" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:paddingStart="4dp"
            android:paddingEnd="4dp">

            <LinearLayout style="@style/SettingRow" android:id="@+id/row_restore">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="恢复为示例课表"
                    android:textColor="@color/text_main"
                    android:textSize="14sp" />
            </LinearLayout>

            <View style="@style/RowDivider" />

            <LinearLayout style="@style/SettingRow" android:id="@+id/row_clear">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="清空全部课程"
                    android:textColor="@color/danger"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- 关于与更新 -->
        <TextView style="@style/SectionTitle" android:layout_marginTop="20dp" android:text="关于与更新" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:paddingStart="4dp"
            android:paddingEnd="4dp">

            <LinearLayout style="@style/SettingRow" android:id="@+id/row_check_update">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="检查更新"
                    android:textColor="@color/text_main"
                    android:textSize="14sp" />
                <TextView
                    android:id="@+id/tv_update_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_sub"
                    android:textSize="13sp" />
            </LinearLayout>

            <View style="@style/RowDivider" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="12dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="启动时自动检查更新"
                    android:textColor="@color/text_main"
                    android:textSize="14sp" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/sw_auto_update"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textOff=""
                    android:textOn="" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:text="课表数据仅保存在本机，卸载应用会被清除"
            android:textColor="@color/text_light"
            android:textSize="11sp" />
    </LinearLayout>
</ScrollView>
